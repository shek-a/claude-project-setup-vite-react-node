{
  "permissions": {
    "allow": [
      "Bash(yarn workspace * test*)",
      "Bash(yarn workspace * typecheck)",
      "Bash(yarn workspace * vitest *)",
      "Bash(yarn eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "mcp__context7"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-before-stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
